# LLM provider keys
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Which generator to use: "openai" or "anthropic"
LLM_PROVIDER=anthropic
GENERATION_MODEL=claude-sonnet-4-6
EMBEDDING_MODEL=text-embedding-3-small

# Vector store
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION=rag_chunks

# Retrieval tuning
DENSE_TOP_K=10
SPARSE_TOP_K=10
RRF_DENSE_WEIGHT=0.7
RRF_SPARSE_WEIGHT=0.3
RERANK_TOP_N=5

# Confidence threshold below which the system returns "I don't know"
CONFIDENCE_THRESHOLD=0.45

# API
API_HOST=0.0.0.0
API_PORT=8000
